{
  "name": "autodealer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "db:demo:clear": "tsx prisma/demo-clear.ts",
    "db:studio": "prisma studio",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "ig:verify": "tsx scripts/instagram-verify.ts",
    "ig:preview": "tsx scripts/instagram-preview.ts",
    "ig:sync": "tsx scripts/instagram-sync.ts",
    "r2:verify": "tsx scripts/r2-verify.ts",
    "ig:token": "tsx scripts/instagram-token.ts",
    "vehicle:confirm": "tsx scripts/vehicle-confirm.ts",
    "ig:reparse": "tsx scripts/instagram-reparse.ts"
  },
  "dependencies": {
    "@prisma/adapter-neon": "7.10.1",
    "@prisma/client": "7.10.1",
    "aws4fetch": "1.0.20",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "8.18.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20.19"
  }
}
