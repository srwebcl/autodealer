# Copia este archivo a .env.local y completa los valores.
# Nunca subas .env.local a Git ni pegues secretos en chats o tickets.

# --- Sitio (Fase 1) ---
# Local: http://localhost:3000 · Producción: dominio canónico (autodealer.cl o www.autodealer.cl, por definir)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Base de datos Neon (Fase 2) ---
# Usa comillas dobles: las URLs contienen "&".
# Con pooling (host con "-pooler"): runtime de la aplicación.
DATABASE_URL=""
# Directa, sin pooler: Prisma Migrate. La integración Neon de Vercel la crea con este nombre.
DATABASE_URL_UNPOOLED=""

# --- Autenticación del panel (Fase 4) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Instagram, API oficial (Fase 5) ---
# Token de larga duración. Solo servidor. Nunca en NEXT_PUBLIC_*, logs ni chat.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""
# graph.facebook.com (Facebook Login) o graph.instagram.com (Instagram Login), según `npm run ig:verify`.
INSTAGRAM_GRAPH_HOST="graph.facebook.com"
INSTAGRAM_GRAPH_VERSION="v26.0"
# Solo se importan publicaciones desde esta fecha (AAAA-MM-DD). Obligatoria.
INSTAGRAM_SYNC_SINCE=""
# Opcional: publicaciones procesadas por ejecución (1–50, por defecto 15).
INSTAGRAM_SYNC_MAX_POSTS=""

# --- Cloudflare R2 (Fase 5) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Cron de sincronización (Fase 5) ---
# Mínimo 16 caracteres aleatorios (ej.: openssl rand -hex 32). Protege /api/instagram/sync.
CRON_SECRET=""
