# Copia este archivo a .env.local y completa los valores.
# Nunca subas .env.local a Git ni pegues secretos en chats o tickets.

# --- Sitio (Fase 1) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Base de datos Neon (Fase 2) ---
DATABASE_URL=
DIRECT_URL=

# --- Autenticación del panel (Fase 4) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Instagram, API oficial (Fase 5) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_VERIFY_TOKEN=

# --- Cloudflare R2 (Fase 5) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# --- Cron de sincronización (Fase 5) ---
CRON_SECRET=
